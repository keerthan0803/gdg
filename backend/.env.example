# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/lead_qualification

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here

# Email Service (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Messaging Services
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_SMS_NUMBER=+1234567890

# Calendar Integration
CALENDLY_API_KEY=your-calendly-api-key
CALENDLY_EVENT_TYPE_UUID=your-event-type-uuid

# CRM Integration (HubSpot)
HUBSPOT_API_KEY=your-hubspot-api-key
HUBSPOT_PORTAL_ID=your-portal-id

# Application Configuration
APP_NAME=AI Lead Qualification Agent
APP_VERSION=1.0.0
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production

# External Data Enrichment
CLEARBIT_API_KEY=your-clearbit-api-key-optional
HUNTER_API_KEY=your-hunter-api-key-optional

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Server Configuration
HOST=0.0.0.0
PORT=8000
